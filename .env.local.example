# Copy to .env.local and fill in. Never commit .env.local.

# Base URL the app is served from. Must match the redirect URIs registered with Spotify/Deezer.
APP_URL=http://127.0.0.1:3000

# Random string, at least 32 characters, used to encrypt the session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# https://www.setlist.fm/settings/api
SETLISTFM_API_KEY=

# https://developer.spotify.com/dashboard
# Redirect URI: http://127.0.0.1:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional. Leave blank until you have a Deezer app; the Deezer option stays hidden until then.
# Redirect URI: http://127.0.0.1:3000/api/auth/deezer/callback
DEEZER_APP_ID=
DEEZER_SECRET=
